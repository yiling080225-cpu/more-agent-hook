# =============================================================
# 多模态 Agent 联邦 MVP — 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
#   cp .env.example .env
# =============================================================

# --- API Keys (至少填一个) ---

# DeepSeek (推荐，Anthropic 兼容，性价比高)
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_KEY=sk-your-deepseek-key-here
DEEPSEEK_URL=https://api.deepseek.com/anthropic

# 智谱 GLM (Anthropic 兼容，视觉能力强)
# 获取: https://open.bigmodel.cn/
GLM_KEY=
GLM_URL=https://open.bigmodel.cn/api/paas/v4

# GPT (Anthropic 兼容代理)
GPT_KEY=
GPT_URL=

# Opus (Anthropic 兼容代理)
OPUS_KEY=
OPUS_URL=

# ClawSocket (本地代理)
CLAWSOCKET_KEY=
CLAWSOCKET_URL=

# Gemini (多模态理解，需翻墙)
# 获取: https://aistudio.google.com/apikey
GEMINI_KEY=

# --- 模型分配 (按你使用的供应商填写) ---
# DeepSeek: deepseek-chat / deepseek-reasoner
# GLM: glm-4-plus / glm-4-flash
# Gemini: gemini-2.5-flash / gemini-2.5-pro
ROUTER_MODEL=deepseek-chat
MULTIMODAL_MODEL=deepseek-chat
CODE_MODEL=deepseek-chat
REVIEW_MODEL=deepseek-chat
PROMPT_MODEL=deepseek-chat
ARCHITECT_MODEL=deepseek-chat

# --- 服务配置 ---
HOST=127.0.0.1
PORT=8000

# --- 存储 ---
SQLITE_PATH=data/checkpoints.db

# --- 日志 ---
LOG_LEVEL=INFO
