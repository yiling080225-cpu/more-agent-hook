# =============================================================
# 多模态 Agent 联邦 MVP — 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# =============================================================

# --- API Keys (至少填一个供应商) ---

# 供应商 1: DeepSeek (Anthropic 兼容, 1M 上下文, 强编码)
# 获取: https://platform.deepseek.com/
DEEPSEEK_KEY=sk-your-deepseek-key-here
DEEPSEEK_URL=https://api.deepseek.com/anthropic

# 供应商 2: 智谱 GLM (Anthropic 兼容, 视觉专长, 中文设计能力强)
# 获取: https://open.bigmodel.cn/
GLM_KEY=your-glm-key-here
GLM_URL=https://open.bigmodel.cn/api/paas/v4

# 供应商 3: clawsocket 聚合 (Anthropic 兼容, 含 Claude + GPT)
# 获取: 自建 clawsocket 实例
CLAWSOCKET_KEY=sk-your-clawsocket-key-here
CLAWSOCKET_URL=https://your-clawsocket-instance.com

# Gemini API Key (多模态理解, 需翻墙)
# 获取: https://aistudio.google.com/apikey
GEMINI_KEY=your-gemini-key-here

# --- 模型分配 (按你使用的供应商填写具体模型名) ---
# Router: 路由任务用, 推荐便宜快速的模型
ROUTER_MODEL=claude-sonnet-4-6

# 多模态 Agent: 处理图像/视频/音频, 需视觉能力
MULTIMODAL_MODEL=claude-sonnet-4-6

# 代码 Agent: 生成代码, 推荐大上下文
CODE_MODEL=claude-sonnet-4-6

# 审查 Agent: 审查代码, 推荐成本低的模型
REVIEW_MODEL=claude-haiku-4-5

# --- 服务配置 ---
HOST=127.0.0.1
PORT=8000

# --- 存储 ---
SQLITE_PATH=data/checkpoints.db

# --- 日志 ---
LOG_LEVEL=INFO
