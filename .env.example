# =============================================================
# 多模态 Agent 联邦 MVP — 环境变量配置
# 复制此文件为 .env 并填入实际值
# =============================================================

# --- 必填: AI API Keys ---
# Gemini API Key (用于多模态理解)
# 获取地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API Key (用于代码生成)
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- 可选: 模型选择 ---
# 多模态模型 (默认 gemini-2.5-flash)
MULTIMODAL_MODEL=gemini-2.5-flash

# 代码生成模型 (默认 claude-sonnet-4-6)
CODE_MODEL=claude-sonnet-4-6

# 审查模型 (默认 claude-haiku-4-5，成本低)
REVIEW_MODEL=claude-haiku-4-5

# 路由模型 (默认 gemini-2.5-flash)
ROUTER_MODEL=gemini-2.5-flash

# --- 服务配置 ---
HOST=127.0.0.1
PORT=8000

# --- 存储 ---
SQLITE_PATH=data/checkpoints.db

# --- 日志 ---
LOG_LEVEL=INFO
